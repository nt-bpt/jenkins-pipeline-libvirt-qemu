#cloud-config
ssh_pwauth: True
package_reboot_if_required: true
package_update: true
package_upgrade: true
packages:
  - ufw
  - uuid
  - pipx
  - net-tools
  - python3-pip
  - pix
  - libgpgme-dev
  - cmake
  - python3-pkgconfig
  - python3-cairo
users:
  - name: skytester
    gecos: "Sky360 Tester"
    primary_group: skytester
    groups: [sudo]
    lock_passwd: false
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
chpasswd:
  expire: false
  users:
  - {name: skytester, password: sky360, type: text}

