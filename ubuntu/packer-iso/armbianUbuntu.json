{
  "variables": {
    "iso_url": "https://dl.armbian.com/orangepi5-plus/Noble_vendor_server-kisak",
    "iso_checksum": "sha256:908cfea539b6449a932582a03c5ccc2af6561c5625fc9c5b88fc320e07dd7c63"
  },
  "builders": [
    {
      "type": "qemu",
      "name": "ubuntu-arm64",
      "iso_url": "{{user `iso_url`}}",
      "iso_checksum": "{{user `iso_checksum`}}",
      "iso_checksum_type": "sha256",
      "output_directory": "output-ubuntu-arm64",
      "vm_name": "ubuntu-arm64",
      "disk_size": "10000",
      "format": "qcow2",
      "headless": true,
      "http_directory": "http",
      "ssh_username": "ubuntu",
      "ssh_password": "ubuntu",
      "ssh_wait_timeout": "30m",
      "ssh_pty": true,
      "boot_wait": "10s",
      "boot_command": [
        "<enter><wait>",
        "<f6><esc><wait>",
        "auto console=ttyS0,115200n8 serial<enter>"
      ],
      "qemuargs": [
        ["-m", "8G"],
        ["-cpu", "max"],
        ["-smp", "2"],
        ["-M", "virt"],
        ["-kernel", "vmlinuz-6.12.0-current-rockchip-rk3588"],
        ["-initrd", "initrd.img-6.12.0-current-rockchip-rk3588"],
        ["-drive", "if=none,file=Armbian_24.11.2_Orangepi5-plus_noble_current_6.12.0-kisak.img,format=raw,id=hd0"],
        ["-append", "earlyprintk loglevel=8 root=/dev/vda1"],
        ["-device", "VGA"],
        ["-device", "virtio-blk-device,drive=hd0"],
        ["-netdev", "user,id=net0"],
        ["-device", "virtio-net-device,netdev=net0"]
      ]
    }
  ],
  "provisioners": [
    {
      "type": "shell",
      "inline": [
        "echo 'Provisioning...'",
        "sudo apt-get update",
        "sudo apt-get upgrade -y"
      ]
    }
  ]
}